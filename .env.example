# Stage 1 (07082026): Copy this file to .env.local and fill in the values.
# .env.local is gitignored. All values here are CLIENT-side config — the
# Firebase web config is not secret (security comes from Auth rules + App
# Check), but keeping it in env vars lets Netlify scope different values per
# deploy context later.

# Firebase console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zerobasedus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zerobasedus
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key registered with App Check (see STAGE1.md step 5).
# Only used when running against the real backend; emulator runs skip App Check.
VITE_RECAPTCHA_SITE_KEY=

# 'true'  → connect Auth + Firestore to local emulators (npm run emulators)
# anything else → real zerobasedus backend (localhost still, nothing published)
VITE_USE_EMULATORS=true
